# -------------------------------------------------------
# Rewrite rules
# -------------------------------------------------------

RewriteEngine On

# Existing rules
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ $1.html [L]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Redirect http to https
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# -------------------------------------------------------
# Cache: mostrar cambios nuevos sin limpiar caché manualmente
# -------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: siempre revalidar (ve cambios al instante)
  ExpiresByType text/html                 "access plus 0 seconds"

  # Assets con hash en el nombre (_next/static): caché larga
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"

  # Imágenes y fuentes: 1 semana
  ExpiresByType image/jpeg                "access plus 1 week"
  ExpiresByType image/png                 "access plus 1 week"
  ExpiresByType image/webp                "access plus 1 week"
  ExpiresByType image/svg+xml             "access plus 1 week"
  ExpiresByType image/gif                 "access plus 1 week"
  ExpiresByType image/x-icon              "access plus 1 week"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTML: forzar siempre sin caché
  <FilesMatch "\.(html|htm)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    Header always unset ETag
    Header always unset Last-Modified
  </FilesMatch>

  # JSON de precios: siempre fresco
  <FilesMatch "precios\.json$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
  </FilesMatch>

  # Assets de _next/static (tienen hash en el nombre): inmutables
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes: 1 semana
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|gif|ico)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Desactivar mod_cache de Apache para archivos HTML
<IfModule mod_cache.c>
  <FilesMatch "\.(html|htm)$">
    CacheDisable on
  </FilesMatch>
</IfModule>

# Desactivar ETags
FileETag None
